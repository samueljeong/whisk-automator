{
  "manifest_version": 3,
  "name": "Whisk 자동화 도구",
  "version": "3.0.0",
  "description": "Google Whisk AI 이미지 대량 생성 자동화",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "scripting",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://drama-s2ns.onrender.com/*",
    "https://grok.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*",
        "https://labs.google.com/*",
        "https://*.google.com/*whisk*"
      ],
      "js": ["content/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://labs.google.com/*",
        "https://*.google.com/*whisk*"
      ],
      "js": ["content/content.js"]
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["content/grok_interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["content/grok_content.js"]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
